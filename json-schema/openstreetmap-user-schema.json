{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/User",
  "title": "User",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "display_name": {
      "type": "string"
    },
    "account_created": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "img": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "changesets": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        }
      }
    },
    "traces": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        }
      }
    },
    "contributor_terms": {
      "type": "object",
      "properties": {
        "agreed": {
          "type": "boolean"
        }
      }
    }
  }
}