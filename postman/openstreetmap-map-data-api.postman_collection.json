          "id": "e0a45b4d-6162-472c-a762-dd74a777c568",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/map?bbox=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "map"
              ],
              "query": [
                {
                  "description": "(Required) Bounding box as min_lon,min_lat,max_lon,max_lat (e.g., -0.489,51.28,0.236,51.686)",
                  "key": "bbox",
                  "value": "<string>"
                }
              ]
            },
            "description": "Retrieve all OSM nodes, ways, and relations within a bounding box. Maximum area: 0.25 square degrees. Returns all objects with their current attributes and tags. High-volume use should use Overpass API instead."
